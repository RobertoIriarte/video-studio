{
  "name": "@video-studio/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4173 --strictPort",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@remotion/player": "4.0.544",
    "@video-studio/contracts": "workspace:*",
    "@video-studio/render": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.74.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
