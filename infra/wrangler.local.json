{
  "$schema": "../apps/api/node_modules/wrangler/config-schema.json",
  "name": "video-studio-api-local",
  "main": "../apps/api/src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "video-studio-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "video-studio-local-media", "remote": false }],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "APP_ENV": "local",
    "APP_VERSION": "0.0.0"
  }
}
