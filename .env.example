# Plantilla de nombres; no contiene credenciales ni valores de entorno.
# API local: APP_ENV/APP_VERSION se declaran sin secretos en infra/wrangler.local.json.
APP_ENV=
APP_VERSION=
APP_ORIGIN=
AUTH_SECRET=
AUTH_BOOTSTRAP_TOKEN=
BOOTSTRAP_IDEMPOTENCY_KEY=
# Configuración con valores: archivo privado fuera del repo, generado por pnpm local:setup.
AGENT_API_URL=
AGENT_TOKEN=
LOCAL_MEDIA_ROOT=
# PROVIDER_*: nombres concretos al implementar cada integración autorizada.
